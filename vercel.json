{
  "version": 2,
  "builds": [
    {
      "src": "backend/Server.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/Server.js"
    },
    {
      "source": "/send-mail",
      "destination": "/backend/Server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
